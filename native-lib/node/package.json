{
  "name": "dataweave-native",
  "version": "0.0.1",
  "description": "Node.js bindings for the DataWeave native library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node-gyp rebuild && tsc",
    "build:addon": "node-gyp rebuild",
    "build:ts": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:tck": "vitest run --project tck",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run --project unit --coverage",
    "pack": "node scripts/pack-packages.mjs"
  },
  "files": [
    "dist/",
    "docs/"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "gypfile": true,
  "author": "MuleSoft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mulesoft/data-weave-cli.git"
  },
  "homepage": "https://dataweave.mulesoft.com/",
  "bugs": {
    "url": "https://github.com/mulesoft/data-weave-cli/issues"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  },
  "optionalDependencies": {
    "dataweave-native-linux-x64": "0.0.1",
    "dataweave-native-win32-x64": "0.0.1",
    "dataweave-native-darwin-arm64": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@vitest/coverage-v8": "^5.0",
    "fast-xml-parser": "^5.10.1",
    "node-gyp": "^11",
    "typescript": "^5.5",
    "vitest": "^5.0"
  }
}
